{
  // Deploy with:  cd worker && npx wrangler deploy
  //
  // Separate from the repo-root wrangler.jsonc, which serves the static site.
  // This is only the lobby proxy; the site itself stays on GitHub Pages.
  //
  // No cron trigger and no KV binding: those existed to detect games already in
  // progress for the Live page, which has been removed. Without a consumer they
  // would just be a scheduled job burning requests, so the Worker is back to
  // answering requests only.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lotr-lobby-proxy",
  "main": "lobby-proxy.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  }
}
